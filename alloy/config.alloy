// Scrapes the smokeping prober and forwards straight to Grafana Cloud Metrics
// (Mimir) over remote_write. No local Prometheus, no disk, no retention limits
// to manage.

prometheus.scrape "smokeping" {
  targets         = [{
    __address__ = sys.env("SP_TARGET"),
  }]
  forward_to      = [prometheus.relabel.drop_runtime.receiver]
  job_name        = "smokeping"
  scrape_interval = sys.env("SP_SCRAPE_INTERVAL")

  // Alloy refuses to start if scrape_timeout >= scrape_interval, and the
  // default is 10s -- so this must be set explicitly whenever the interval is
  // below 10s. Keep it strictly below the interval: at a 0.4s scrape this
  // leaves ~100ms of slack, which is ample for a local /metrics read.
  scrape_timeout = "300ms"

  metrics_path = "/metrics"
}

// 56 of the 80 series the prober exposes are Go runtime and process
// bookkeeping (go_memstats_*, go_gc_*, process_*, promhttp_*). They say nothing
// about network health, and at a 0.4s scrape they would be 70% of ingested
// volume. Dropping them here is what keeps the faster scrape affordable.
prometheus.relabel "drop_runtime" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "go_.*|process_.*|promhttp_.*"
    action        = "drop"
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GF_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GF_CLOUD_INSTANCE_ID")
      password = sys.env("GF_CLOUD_API_TOKEN")
    }

    queue_config {
      capacity             = 5000
      max_shards           = 50
      max_samples_per_send = 1000
    }
  }

  external_labels = {
    site = sys.env("SITE_LABEL"),
  }
}
